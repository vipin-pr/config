[
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-t": "terminal_panel::Toggle"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-b": "workspace::ToggleLeftDock",
      "ctrl-j": "pane::ActivateNextItem",
      "ctrl-h": "pane::ActivatePreviousItem",
      "ctrl-t": "terminal_panel::Toggle"
    }
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "j j": "vim::NormalBefore"
    }
  },
  {
    "context": "Editor && vim_mode == normal && !menu",
    "bindings": {
      "alt-t": ["workspace::SendKeystrokes", "c x i w w c x i w"]
    }
  }
]